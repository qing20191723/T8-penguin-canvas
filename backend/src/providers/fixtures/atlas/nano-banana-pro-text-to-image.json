{
  "type": "object",
  "required": ["model", "prompt"],
  "properties": {
    "model": { "type": "string", "default": "google/nano-banana-pro/text-to-image" },
    "prompt": { "type": "string" },
    "aspect_ratio": { "type": "string", "enum": ["1:1", "16:9", "9:16"] },
    "resolution": { "type": "string", "default": "1k", "enum": ["1k", "2k", "4k"] },
    "output_format": { "type": "string", "default": "default", "enum": ["default", "png", "jpeg"] }
  }
}
